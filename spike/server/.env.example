# Copy to .env (not versioned; Wrangler reads it both as system variables and as local vars) and fill in from the Supabase dashboard.
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Postgres connection used by Hyperdrive in local dev (Connect > Session pooler, port 5432).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=
# Publishable key (Settings > API Keys), used only by token.sh to sign in the test users.
SUPABASE_PUBLISHABLE_KEY=
# Password given to both test users spike-a@ and spike-b@cosasimangia.test.
SPIKE_PASSWORD=
