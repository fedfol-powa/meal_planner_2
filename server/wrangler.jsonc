{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "cosasimangia",
	"account_id": "d0deb498ea6d174e013c878ff38d8dfb",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	// Hourly weekly job (spec section 4): next week for families past Wednesday 20:00, retries of open jobs.
	// Nightly export to R2 at 02:30 UTC, retried at 04:30 when the night has none (spec section 8).
	"triggers": { "crons": ["0 * * * *", "30 2,4 * * *"] },
	"workers_dev": true,
	"vars": {
		// Supabase project URL; token issuer and JWKS are derived from it.
		"SUPABASE_URL": "https://lronuqvtjdhfyychnscr.supabase.co",
		// Publishable key of the project (public value): Project Settings › API Keys.
		"SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ZN5AmAKDK-_xVuKSINnLnw_EZa3ns7f",
		// Id of BACKUP_ENCRYPTION_KEY (a Worker secret), written in each export header.
		"BACKUP_KEY_ID": "k1"
	},
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"assets": {
		"directory": "../web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// Only these paths run the Worker; everything else is served as a static file.
		"run_worker_first": ["/api/*", "/mcp", "/.well-known/*", "/shopping-lists/*"]
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			// Production config `cosasimangia` (cache disabled, explicit origin connection limit).
			"id": "4c2038adf73d4ed094584a3244f7fbf2"
		}
	],
	// Public invitation operations (spec W9): per-IP limits; namespace ids unique in the Cloudflare account.
	"ratelimits": [
		{ "name": "INVITE_READ_LIMIT", "namespace_id": "9101", "simple": { "limit": 30, "period": 60 } },
		{ "name": "INVITE_ACCEPT_LIMIT", "namespace_id": "9102", "simple": { "limit": 5, "period": 60 } }
	],
	// Nightly exports: private bucket in the EU jurisdiction, created on 12 October 2026.
	"r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "cosasimangia-backups", "jurisdiction": "eu" }]
}
