{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "cosasimangia",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	// Hourly weekly job (spec section 4): next week for families past Wednesday 20:00, retries of open jobs.
	// Nightly export to R2 at 02:30 UTC, retried at 04:30 when the night has none (spec section 8).
	"triggers": { "crons": ["0 * * * *", "30 2,4 * * *"] },
	"workers_dev": true,
	"vars": {
		// Supabase project URL; token issuer and JWKS are derived from it.
		"SUPABASE_URL": "https://lronuqvtjdhfyychnscr.supabase.co",
		// Publishable key of the project (public value): Project Settings › API Keys.
		// Replace with the value the user gives the coordinator (spec «Passi esterni», step 3).
		"SUPABASE_PUBLISHABLE_KEY": "sb_publishable_REPLACE_ME",
		// Id of BACKUP_ENCRYPTION_KEY (a Worker secret), written in each export header.
		"BACKUP_KEY_ID": "k1"
	},
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"assets": {
		"directory": "../web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// Only these paths run the Worker; everything else is served as a static file.
		"run_worker_first": ["/api/*", "/mcp", "/.well-known/*", "/shopping-lists/*"]
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			// Production config `cosasimangia` (cache disabled, explicit origin connection limit).
			// Replace with the id returned when the coordinator approves creating it.
			"id": "00000000000000000000000000000000"
		}
	],
	// Nightly exports: private bucket in the EU jurisdiction, created by the owner before deploying.
	"r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "cosasimangia-backups", "jurisdiction": "eu" }]
}
